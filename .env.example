DB_USER=starsnap
DB_PASSWORD=replace-with-database-password
DB_HOST=postgres
DB_PORT=5432
DB_NAME=starsnap
DB_SCHEME=postgresql
AI_DATABASE_ENABLED=true
DEBUG=false

ARCFACE_PROVIDERS=CUDAExecutionProvider,CPUExecutionProvider
ARCFACE_MODEL_NAME=buffalo_l
ARCFACE_DET_SIZE=640
ARCFACE_MAX_IMAGE_DIM=1280
MATCH_MIN_SIMILARITY=0.45

JWT_ACCESS_SECRET=replace-with-jwt-secret
AI_INTERNAL_TOKEN=replace-with-separate-internal-token
# Docker/Swarm secret 사용 시 AI_INTERNAL_TOKEN을 비우고 파일 경로를 설정합니다.
AI_INTERNAL_TOKEN_FILE=
AI_FACE_ANALYSIS_MAX_IMAGE_BYTES=15728640
AI_FACE_ANALYSIS_MAX_PIXELS=60000000
AI_FACE_ANALYSIS_MAX_FACES=10
AI_FACE_ANALYSIS_MATCH_STARS=true
AI_FACE_MODEL_VERSION=insightface-0.7.3

PHOTO_API_URL=http://backend:8080/api/file/photo
PHOTO_API_TIMEOUT_SECONDS=10

ACCESS_LOG_ENABLED=true
ACCESS_LOG_URL=http://host.docker.internal:8081/api/server-logs
ACCESS_LOG_SERVICE_NAME=starsnap-ai-backend
ACCESS_LOG_SECRET=
